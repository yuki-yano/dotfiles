#!/usr/bin/env bash

set -euo pipefail

apply_mode() {
  local mode="$1"
  if [[ "$mode" == "transparent" ]]; then
    alacritty msg config -w -1 'window.opacity=0.8'
    tmux set -g window-style 'bg=default'
    tmux set -g window-active-style 'bg=default'
    tmux set -g pane-border-style 'fg=#{?#{pane_modal_flag},#4A4A4A,#{?#{@vde_status_pane_border_color},#{@vde_status_pane_border_color},#4A4A4A}}'
    tmux set -g pane-active-border-style 'fg=#{?#{pane_modal_flag},#4A4A4A,#{?#{@vde_status_pane_border_color},#{@vde_status_pane_border_color},#FFFFFF}}'
  else
    alacritty msg config -w -1 'window.opacity=1.0'
    # tmux HEAD popups are modal panes and inherit the normal pane styles.
    tmux set -g window-style 'bg=#{?#{pane_modal_flag},#181825,#1E1E2E}'
    tmux set -g window-active-style 'bg=#{?#{pane_modal_flag},#181825,#1E1E2E}'
    tmux set -g pane-border-style 'fg=#{?#{pane_modal_flag},#4A4A4A,#{?#{@vde_status_pane_border_color},#{@vde_status_pane_border_color},#4A4A4A}},bg=#{?#{pane_modal_flag},#181825,#1E1E2E}'
    tmux set -g pane-active-border-style 'fg=#{?#{pane_modal_flag},#4A4A4A,#{?#{@vde_status_pane_border_color},#{@vde_status_pane_border_color},#FFFFFF}},bg=#{?#{pane_modal_flag},#181825,#1E1E2E}'
  fi
}

set_nvim_env() {
  local mode="$1"

  if [[ "$mode" == "transparent" ]]; then
    tmux set-environment -g NVIM_TRANSPARENCY 1
  else
    tmux set-environment -g NVIM_TRANSPARENCY 0
  fi
}

action="${1:-toggle}"
current_mode=$(tmux show -gqv '@theme_mode')
current_mode=${current_mode:-transparent}

case "$action" in
  apply)
    apply_mode "$current_mode"
    set_nvim_env "$current_mode"
    ;;
  toggle)
    if [[ "$current_mode" == "transparent" ]]; then
      next_mode="solid"
    else
      next_mode="transparent"
    fi
    tmux set -g @theme_mode "$next_mode"
    apply_mode "$next_mode"
    set_nvim_env "$next_mode"
    tmux display-message "tmux theme mode: ${next_mode}"
    ;;
  *)
    echo "usage: $(basename "$0") [toggle|apply]" >&2
    exit 1
    ;;
esac

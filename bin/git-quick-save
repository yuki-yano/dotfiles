#!/bin/sh

# Git working tree quick save utility.
# The snapshot is built in a temporary index and recorded in the reflog of
# refs/worktree/quick-save, so HEAD, the index, ORIG_HEAD and the working tree
# are never touched, even in the middle of a merge, rebase or cherry-pick.

label=${GIT_QUICK_SAVE_LABEL:-"Git quick save"}
snapshot_ref=refs/worktree/quick-save

msg=""
if [ "$#" -gt 0 ]; then
  non_empty_args=""
  for arg in "$@"; do
    if [ -n "$arg" ]; then
      if [ -z "$non_empty_args" ]; then
        non_empty_args="$arg"
      else
        non_empty_args="$non_empty_args $arg"
      fi
    fi
  done

  if [ -n "$non_empty_args" ]; then
    msg=" - $non_empty_args"
  fi
fi

log() {
  printf '%s: %s\n' "$label" "$1"
}

if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
  log "Not a Git repository."
  exit 1
fi

index=$(git rev-parse --path-format=absolute --git-path index)
temporary_index=$(mktemp "${TMPDIR:-/tmp}/git-quick-save-index.XXXXXX") || exit 1
trap 'rm -f "$temporary_index"' EXIT
if [ -f "$index" ]; then
  cp "$index" "$temporary_index" || exit 1
else
  rm -f "$temporary_index"
fi

if ! GIT_INDEX_FILE=$temporary_index git add --all; then
  log "Failed: git add."
  exit 1
fi
tree=$(GIT_INDEX_FILE=$temporary_index git write-tree) || {
  log "Failed: git write-tree."
  exit 1
}

commit_message="$label: $(date -R)$msg"
if head=$(git rev-parse --verify --quiet HEAD); then
  parent_tree=$(git rev-parse "$head^{tree}")
  commit=$(git commit-tree "$tree" -p "$head" -m "$commit_message") || exit 1
else
  parent_tree=""
  commit=$(git commit-tree "$tree" -m "$commit_message") || exit 1
fi

if ! git update-ref --create-reflog -m "$commit_message" "$snapshot_ref" "$commit"; then
  log "Failed: recording the snapshot in $snapshot_ref."
  exit 1
fi

commit_hash=$(git rev-parse --short "$commit")
if [ "$tree" = "$parent_tree" ]; then
  echo "$label!$msg (commit $commit_hash, empty snapshot)"
else
  echo "$label!$msg (commit $commit_hash)"
fi

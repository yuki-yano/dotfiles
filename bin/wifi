#!/usr/bin/env bash

set -euo pipefail

wifi_interface="$(
  /usr/sbin/networksetup -listallhardwareports |
    awk '/^Hardware Port: (Wi-Fi|AirPort)$/ { getline; sub(/^Device: /, ""); print; exit }'
)"

if [[ -z "$wifi_interface" ]]; then
  echo "#[fg=red]offline"
  exit 1
fi

# `system_profiler SPAirPortDataType` takes about ten seconds on current macOS and
# reports a transmit rate that oscillates between samples. tmux reruns this widget
# from status-right, so those late, width-changing results make the status line flash.
# The cached association record contains the stable SSID and is available immediately.
/usr/bin/python3 - "$wifi_interface" <<'PY'
import plistlib
import re
import subprocess
import sys

iface = sys.argv[1]
key = f"State:/Network/Interface/{iface}/AirPort"

try:
    state = subprocess.check_output(
        ["/usr/sbin/scutil"],
        input=f"show {key}\n",
        text=True,
        stderr=subprocess.DEVNULL,
    )
except Exception:
    print("#[fg=red]offline")
    raise SystemExit(1)

match = re.search(r"CachedScanRecord\s*:\s*<data>\s*0x([0-9A-Fa-f]+)", state)
if not match:
    print("#[fg=red]offline")
    raise SystemExit(1)

try:
    plist = plistlib.loads(bytes.fromhex(match.group(1)))
except Exception:
    print("#[fg=red]offline")
    raise SystemExit(1)

objects = plist.get("$objects")
root = plist.get("$top", {}).get("root")
if objects is None or root is None:
    print("#[fg=red]offline")
    raise SystemExit(1)

UID = plistlib.UID


def decode(value):
    if isinstance(value, UID):
        return decode(objects[value.data])
    if isinstance(value, list):
        return [decode(item) for item in value]
    if isinstance(value, dict):
        if "NS.keys" in value and "NS.objects" in value:
            keys = decode(value["NS.keys"])
            vals = decode(value["NS.objects"])
            return {k: v for k, v in zip(keys, vals) if isinstance(k, str)}
        if "NS.data" in value:
            return decode(value["NS.data"])
        if "NS.string" in value:
            return decode(value["NS.string"])
        return {k: decode(v) for k, v in value.items() if k != "$class"}
    return value

decoded = decode(root)
ssid = decoded.get("SSID_STR") if isinstance(decoded, dict) else None
if not isinstance(ssid, str) or not ssid:
    print("#[fg=red]offline")
    raise SystemExit(1)

print(f"#[fg=white]{ssid}")
PY

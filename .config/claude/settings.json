{
  "cleanupPeriodDays": 9999,
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "0",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_AFK_TIMEOUT_MS": "3600000"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "vde-monitor-hook PreToolUse"
          },
          {
            "type": "command",
            "command": "if [ -n \"$TMUX\" ]; then vt hook claude PreToolUse; else cat >/dev/null; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "vde-monitor-hook PostToolUse"
          },
          {
            "type": "command",
            "command": "if [ -n \"$TMUX\" ]; then vt hook claude PostToolUse; else cat >/dev/null; fi"
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claude/hooks/compact-guard.sh\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "vde-monitor-hook Notification"
          },
          {
            "type": "command",
            "command": "if [ -n \"$TMUX\" ]; then vt hook claude Notification; else cat >/dev/null; fi"
          },
          {
            "type": "command",
            "command": "if [ -n \"$HC_TERMINAL_ID\" ] && command -v vte >/dev/null; then vte hook claude Notification; else cat >/dev/null; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$TMUX$HERDR_PANE_ID\" ]; then vde-notifier --claude --skip-claude-non-interactive; else cat >/dev/null; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "vde-monitor-hook Stop"
          },
          {
            "type": "command",
            "command": "if [ -n \"$TMUX\" ]; then vt hook claude Stop; else cat >/dev/null; fi"
          },
          {
            "type": "command",
            "command": "if [ -n \"$HC_TERMINAL_ID\" ] && command -v vte >/dev/null; then vte hook claude Stop; else cat >/dev/null; fi"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$TMUX\" ]; then vt hook claude StopFailure; else cat >/dev/null; fi"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "vde-monitor-hook UserPromptSubmit"
          },
          {
            "type": "command",
            "command": "if [ -n \"$TMUX\" ]; then vt hook claude UserPromptSubmit; else cat >/dev/null; fi"
          },
          {
            "type": "command",
            "command": "if [ -n \"$HC_TERMINAL_ID\" ] && command -v vte >/dev/null; then vte hook claude UserPromptSubmit; else cat >/dev/null; fi"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claude/hooks/compact-guard.sh\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claude/hooks/compact-precompact.sh\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "vde-monitor-hook SubagentStart"
          },
          {
            "type": "command",
            "command": "if [ -n \"$TMUX\" ]; then vt hook claude SubagentStart; else cat >/dev/null; fi"
          },
          {
            "type": "command",
            "command": "if [ -n \"$HC_TERMINAL_ID\" ] && command -v vte >/dev/null; then vte hook claude SubagentStart; else cat >/dev/null; fi"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "vde-monitor-hook SubagentStop"
          },
          {
            "type": "command",
            "command": "if [ -n \"$TMUX\" ]; then vt hook claude SubagentStop; else cat >/dev/null; fi"
          },
          {
            "type": "command",
            "command": "if [ -n \"$HC_TERMINAL_ID\" ] && command -v vte >/dev/null; then vte hook claude SubagentStop; else cat >/dev/null; fi"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$TMUX\" ]; then vt hook claude SessionStart; else cat >/dev/null; fi"
          },
          {
            "type": "command",
            "command": "if [ -n \"$HC_TERMINAL_ID\" ] && command -v vte >/dev/null; then vte hook claude SessionStart; else cat >/dev/null; fi"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.config/claude/hooks/compact-recovery.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$TMUX\" ]; then vt hook claude SessionEnd; else cat >/dev/null; fi"
          },
          {
            "type": "command",
            "command": "if [ -n \"$HC_TERMINAL_ID\" ] && command -v vte >/dev/null; then vte hook claude SessionEnd; else cat >/dev/null; fi"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "cc-statusline.ts"
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": false,
    "context-mode@context-mode": false,
    "toolcall-recover@nam-tech-studio": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "nam-tech-studio": {
      "source": {
        "source": "github",
        "repo": "nam-tech-studio/toolcall-recover"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "advisorModel": "fable",
  "subagentPromptCacheTtl": "1h",
  "showClearContextOnPlanAccept": true,
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "tui": "default",
  "autoMemoryEnabled": false,
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "preferredNotifChannel": "notifications_disabled",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "switchModelsOnFlag": false
}
